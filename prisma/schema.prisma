generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL بيعدّي على pgbouncer (بورت 6543) — كويس للتشغيل، لكن migrate/db push
  // محتاجين اتصال مباشر (بورت 5432) وإلا بيفشلوا
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  cartItems     CartItem[]
}

enum Role {
  USER
  ADMIN
}

model Product {
  id          String      @id @default(cuid())
  slug        String?     @unique
  // كود مختصر للمنتج (مثال: 480O4) — للبحث السريع وللوصول للطلب من رسالة البوت
  code        String?     @unique
  // حرف اللون السائد (R/O/Y/G/C/B/P/K/W/D) — يستخدم في الكود وفي الفلترة بالألوان
  colorKey    String?
  // المنتج معروض لكن لسه مش جاهز للبيع — بيظهر عليه شارة وميتشريش
  comingSoon  Boolean     @default(false)
  title       String
  description String      @db.Text
  price       Float
  priceLabel  String?
  category    Category
  subCategory String?
  imageUrl    String
  images      String[]    @default([])
  videoUrl    String?
  videos      String[]    @default([])
  rating      Float       @default(5)
  ratingCount Int         @default(0)
  tags        String[]
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  cartItems   CartItem[]
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  name      String?
  password  String?
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

enum Category {
  ALERTS
  STREAM
  PACKAGE
  THREE_D
  VIDEO
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  total           Float
  paymentMethod   String
  paymentId       String?
  stripeSessionId String?
  paypalOrderId   String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  IN_PROGRESS
  DELIVERED
  FAILED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  price     Float
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String?
  userEmail      String
  userName       String?
  userPhone      String?
  productName    String?
  amount         Float
  currency       String   @default("EGP")
  method         String
  status         String   @default("success")
  deliveryStatus String   @default("pending") // pending | in_progress | delivered
  createdAt      DateTime @default(now())
}

// ── الأوفرليات ────────────────────────────────────────────────
// التركيبات مش منتجات: المنتج بيتشتري مرة، والتركيبة بتيجي ضمن اشتراك
// وبتفضل شغّالة طول ما الاشتراك شغّال. فليها موديل لوحدها بدل ما نحشرها
// في Product بحقول مالهاش لازمة.
model Overlay {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String?
  category    OverlayCategory
  // مسار الملف اللي بيتحط في OBS، مثلاً /overlays/qatar-plate.html
  file        String
  // صورة ثابتة للكارت — بتظهر لحد ما الفيديو يحمّل
  poster      String?
  // التركيبة المجانية بعلامة Tilago: بتشتغل من غير اشتراك
  isFree      Boolean         @default(false)
  featured    Boolean         @default(false)
  active      Boolean         @default(true)
  sort        Int             @default(0)
  // "الجديد" في الكتالوج بيترتب بالتاريخ ده — وهو كمان اللي بيثبت
  // إن المكتبة فعلاً بتكبر بدل ما ندّعي
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, active])
}

enum OverlayCategory {
  SUPPORTERS  // داعمين
  CHALLENGES  // تحديات
  GOALS       // أهداف
  DECOR       // تزيين
}

// ── الاشتراكات ────────────────────────────────────────────────
// الطلب العادي بيخلص لما يتسلّم. الاشتراك بيفضل شغّال وبيقف لوحده،
// فمحتاج مدة وحالة ومفتاح.
model Subscription {
  id        String    @id @default(cuid())
  userEmail String    @unique
  // m1 | m3 | y
  plan      String
  // pending: دفع ومستني تأكيدك · active: شغّال · expired: خلص
  status    String    @default("pending")
  startsAt  DateTime?
  // النظام بيحسبه من الخطة وقت التأكيد — مش بالإيد، عشان مايحصلش غلط
  // يخلي عميل دافع واشتراكه واقف أو العكس
  endsAt    DateTime?
  // المفتاح اللي في رابط التركيبة. عشوائي، ويتغيّر لو اتسرّب فكل
  // روابط العميل تتجدد مرة واحدة.
  token     String    @unique
  // ألوانه ولوجوه — بيتحفظوا هنا فالرابط في OBS مايتغيّرش لما يغيّرهم
  theme     Json?
  // السعر المقفول للي اشترك في الإطلاق
  priceLocked Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, endsAt])
}
