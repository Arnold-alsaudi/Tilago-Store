generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  cartItems     CartItem[]
}

enum Role {
  USER
  ADMIN
}

model Product {
  id          String      @id @default(cuid())
  slug        String?     @unique
  title       String
  description String      @db.Text
  price       Float
  priceLabel  String?
  category    Category
  subCategory String?
  imageUrl    String
  images      String[]    @default([])
  videoUrl    String?
  videos      String[]    @default([])
  rating      Float       @default(5)
  ratingCount Int         @default(0)
  tags        String[]
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  cartItems   CartItem[]
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  name      String?
  password  String?
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

enum Category {
  ALERTS
  STREAM
  PACKAGE
  THREE_D
  VIDEO
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)
  total           Float
  paymentMethod   String
  paymentId       String?
  stripeSessionId String?
  paypalOrderId   String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  IN_PROGRESS
  DELIVERED
  FAILED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  price     Float
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String?
  userEmail      String
  userName       String?
  userPhone      String?
  productName    String?
  amount         Float
  currency       String   @default("EGP")
  method         String
  status         String   @default("success")
  deliveryStatus String   @default("pending") // pending | in_progress | delivered
  createdAt      DateTime @default(now())
}
